<Application x:Class="ObuvApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Pages/LoginWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="MainBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AdditionalBackground" Color="#7FFF00"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00FA9A"/>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Application.Resources>
</Application>
