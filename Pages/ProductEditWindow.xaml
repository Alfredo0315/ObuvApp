<Window x:Class="ObuvApp.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар — ООО «Обувь»" Height="640" Width="720"
        MinHeight="600" MinWidth="680"
        Icon="pack://application:,,,/Icon.ico"
        WindowStartupLocation="CenterOwner"
        FontFamily="Times New Roman" FontSize="14"
        Background="{StaticResource MainBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ID" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox x:Name="IdBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,4"
                         Padding="3" IsTabStop="False"/>

                <TextBlock Grid.Row="1" Text="Артикул *" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox x:Name="ArticleBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="3"
                         MaxLength="20" TabIndex="0"/>

                <TextBlock Grid.Row="2" Text="Наименование *" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox x:Name="NameBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Padding="3"
                         MaxLength="100" TabIndex="1"/>

                <TextBlock Grid.Row="3" Text="Категория *" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox x:Name="CategoryBox" Grid.Row="3" Grid.Column="1" Margin="0,4"
                          DisplayMemberPath="Name" SelectedValuePath="CategoryID" TabIndex="2"/>

                <TextBlock Grid.Row="4" Text="Производитель *" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox x:Name="ManufacturerBox" Grid.Row="4" Grid.Column="1" Margin="0,4"
                          DisplayMemberPath="Name" SelectedValuePath="ManufacturerID" TabIndex="3"/>

                <TextBlock Grid.Row="5" Text="Поставщик *" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox x:Name="SupplierBox" Grid.Row="5" Grid.Column="1" Margin="0,4"
                          DisplayMemberPath="Name" SelectedValuePath="SupplierID" TabIndex="4"/>

                <TextBlock Grid.Row="6" Text="Единица измерения *" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox x:Name="UnitBox" Grid.Row="6" Grid.Column="1" Margin="0,4"
                          DisplayMemberPath="Name" SelectedValuePath="UnitID" TabIndex="5"/>

                <TextBlock Grid.Row="7" Text="Цена *" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox x:Name="PriceBox" Grid.Row="7" Grid.Column="1" Margin="0,4" Padding="3" TabIndex="6"
                         ToolTip="Неотрицательное число, не более двух знаков после запятой"/>

                <TextBlock Grid.Row="8" Text="Скидка, % *" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox x:Name="DiscountBox" Grid.Row="8" Grid.Column="1" Margin="0,4" Padding="3" MaxLength="3" TabIndex="7"
                         ToolTip="Целое число от 0 до 100"/>

                <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Количество на складе *" VerticalAlignment="Center"/>
                        <TextBox x:Name="StockBox" Grid.Column="1" Padding="3" MaxLength="9" TabIndex="8"
                                 ToolTip="Целое неотрицательное число"/>
                    </Grid>
                    <TextBlock Text="Описание товара" Margin="0,6,0,3"/>
                    <TextBox x:Name="DescriptionBox" Height="110" Padding="3" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             MaxLength="500" TabIndex="9"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Фото товара" Margin="0,4,0,4"/>
                <Border BorderBrush="Black" BorderThickness="1" Width="300" Height="200"
                        HorizontalAlignment="Left">
                    <Image x:Name="PhotoImage" Stretch="Uniform"/>
                </Border>
                <Button Content="Выбрать фото..." Style="{StaticResource PlainButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="ChoosePhoto_Click" TabIndex="10"/>
                <TextBlock Text="Фото будет уменьшено до 300×200 пикселей" Foreground="#555"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="DeleteButton" Content="Удалить" DockPanel.Dock="Left"
                    Style="{StaticResource PlainButton}" Margin="0" Click="Delete_Click"
                    Visibility="Collapsed" TabIndex="13"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Назад" Style="{StaticResource PlainButton}" IsCancel="True"
                        Click="Back_Click" TabIndex="12"/>
                <Button Content="Сохранить" Style="{StaticResource AccentButton}" Click="Save_Click"
                        TabIndex="11"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
